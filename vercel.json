{
  "version": 2,
  "builds": [{ "src": "ui.html", "use": "@vercel/static" }],
  "routes": [
    { "src": "/", "dest": "/ui.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
