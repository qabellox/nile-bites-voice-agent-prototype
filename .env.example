# Nile Bites voice agent - environment variables
#
# Copy to `.env` only if you need a hosted provider. Nothing here is required
# for the default local setup: Ollama needs no key, Edge TTS needs no key, and
# the deterministic tool layer needs no network at all.
#
# .env is gitignored. Never commit real keys.

# --- hosted LLM providers (only if you are NOT using a local server) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- config overrides, applied after the YAML files ---
# Nested keys use a double underscore. Useful for pinning a formal run without
# editing the config, e.g. a fixed weekday instead of experiment.business_weekday: auto.
#
# NBVA_EXPERIMENT__IS_RESEARCH_RUN=true
# NBVA_EXPERIMENT__PARTICIPANT_ID=P001
# NBVA_EXPERIMENT__BUSINESS_WEEKDAY=wednesday
# NBVA_LLM__PROVIDER=openai
# NBVA_LLM__MODEL=gpt-4o
# NBVA_TTS__PROVIDER=edge
